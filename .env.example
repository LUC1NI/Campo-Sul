# Banco de dados — Supabase
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Auth.js
NEXTAUTH_SECRET="gerar com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage (para PDFs)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_BUCKET="documentos"

# Seed — credenciais do admin inicial
SEED_ADMIN_EMAIL="admin@camposul.com.br"
SEED_ADMIN_PASSWORD="trocar_antes_de_usar"

# Focus NFe API — https://focusnfe.com.br (Plano Retail NFCe)
# Gere o token em: https://app.focusnfe.com.br/configuracoes/tokens
FOCUSNFE_TOKEN="token_de_producao_aqui"
FOCUSNFE_TOKEN_HML="token_de_homologacao_aqui"
FOCUSNFE_AMBIENTE="homologacao"   # producao | homologacao

# Dados da empresa (aparecem nos PDFs)
EMPRESA_RAZAO_SOCIAL="CampoSul Agropecuária"
EMPRESA_CNPJ="00.000.000/0001-00"
EMPRESA_IE="000/0000000"
EMPRESA_ENDERECO="Rua Exemplo, 123 - Cidade/RS"
EMPRESA_FONE="(51) 99999-9999"
